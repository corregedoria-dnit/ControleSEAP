# PostgreSQL do Supabase. Use a conexão apropriada ao ambiente/deployment.
# Formato: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# URL base do projeto Supabase, usada para validar JWTs e buscar JWKS.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Somente para projetos que comprovadamente usam assinatura HS256 legada.
# Nunca publicar este segredo.
SUPABASE_JWT_SECRET=

# Separe múltiplas origens por vírgula.
CORS_ORIGINS=http://localhost:5173
